# Copy to .env.local and adjust (do not commit real secrets)

# Express API (Bearer access_token from login is forwarded on participant writes).
#
# A) Direct to Express (needs CORS ok for the web origin):
#    NEXT_PUBLIC_API_BASE=http://localhost:4000/api
#    (If you omit `/api`, localhost URLs get it auto-appended in getApiBaseUrl.) 
#
# B) Same-origin `/api` → proxied to Express by app/api/[...path]/route.ts (dev default target :4000):
#    NEXT_PUBLIC_API_BASE=/api
#    API_PROXY_TARGET=http://127.0.0.1:4000
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
# Server-only: used by /api/cron/sync-football to reach Express.
# API_PROXY_TARGET=http://127.0.0.1:4000
# Server-only: Vercel Cron sends Authorization: Bearer $CRON_SECRET; route forwards X-Cron-Secret. Use 16+ random chars.
# CRON_SECRET=

# Supabase (same project URL as backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Same “anon” / “publishable” key as browser Auth (never use service role here)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Site URL for OAuth / magic-link redirect (optional; defaults to window.location.origin).
# Add the same URL (no #fragment) under Supabase → Auth → URL configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase auth.users.id of the superadmin — must match backend ADMIN_UID. Admin tab only for this user.
# NEXT_PUBLIC_SUPERADMIN_UID=
# Or legacy name:
# NEXT_PUBLIC_ADMIN_UID=
