# Copy to .env and fill in values (never commit .env)

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Supabase (Express uses PostgREST + Auth API) ---
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key (Auth OTP, signup/password grant). Safe to match frontend; never use as server-only secret.
SUPABASE_KEY=your-anon-or-publishable-key
# Service role JWT — server-only: bypasses RLS on PostgREST and powers Supabase Admin Auth (`auth.admin.deleteUser`, admin user list).
# Dashboard → API → service_role (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
# JWT signing secret — required for HS256 tokens. ES256/RS256 access tokens are verified via JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json (no secret needed for those).
SUPABASE_JWT_SECRET=your-jwt-signing-secret-from-supabase

# --- Participant API hardening (after clients send Authorization: Bearer …) ---
# true = allow PATCH/DELETE without JWT AND return full GET /participants squads before deadline (backward compatible). Set false in production to hide others' lineups until the deadline passes.
PARTICIPANT_LEGACY_OPEN_MUTATIONS=true
# If set, callers may send header X-Admin-Secret matching this value instead of a user JWT when LEGACY is false.
# ADMIN_API_SECRET=
# Superadmin: same UUID as web `NEXT_PUBLIC_SUPERADMIN_UID` — full API access + internal routes with Bearer session.
# ADMIN_UID=

# Optional / reserved for upcoming features (not read by env validation yet):
# API-Football (api-sports.io) key — required for /api/internal/sync-fixtures if you use that integration
# API_FOOTBALL_KEY=
# football-data.org v4 — https://www.football-data.org/ (different API; used e.g. in test-api.js)
# FOOTBALL_DATA_TOKEN=
# Transactional mail (signup confirmation + pool invitations). Use Brevo and/or Resend.
# Brevo: https://app.brevo.com → SMTP & API
# Recommended: create an API key (starts with xkeysib-) and set either BREVO_API_KEY or BREVO_REST_API_KEY — no SMTP username issues.
# SMTP relay (xsmtpsib-): same as Brevo’s Node nodemailer sample — auth.user + pass from SMTP tab; sendMail from can differ.
# Set BREVO_SMTP_LOGIN to that auth.user (often something@brevo.com). BREVO_FROM_EMAIL is only the visible From address.
# If BREVO_API_KEY is xsmtpsib-, you can add BREVO_REST_API_KEY=xkeysib-... to use REST instead of SMTP.
# Sender address must be verified in Brevo (Senders & IP / Domains).
# BREVO_API_KEY=
# BREVO_REST_API_KEY=
# BREVO_FROM_EMAIL=noreply@your-verified-domain.com
# BREVO_FROM_NAME=WK Poule
# BREVO_SMTP_LOGIN=
# Resend (used only if Brevo is not configured, or as fallback if Brevo send fails)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@your-domain.com
# Secret for cron caller header: X-Cron-Secret (recommended for internal sync endpoint)
# CRON_SECRET=
# DEFAULT_COMPETITION_SLUG=wc2026

# Public URL of the Next.js app (no trailing slash) — used in ?invite= links from pool owners
# PUBLIC_APP_URL=http://localhost:3000
