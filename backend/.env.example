# Copy to .env and fill in values (never commit .env)

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Supabase (Express uses PostgREST + Auth API) ---
SUPABASE_URL=https://your-project.supabase.co
# Anon/service key for server-side PostgREST calls (keep server-only; prefer service role if you bypass RLS).
SUPABASE_KEY=your-anon-or-service-role-key
# Dashboard → Project Settings → API → JWT signing secret (validates browser access tokens on /api).
SUPABASE_JWT_SECRET=your-jwt-signing-secret-from-supabase

# --- Participant API hardening (after clients send Authorization: Bearer …) ---
# true = allow PATCH/DELETE without JWT (backward compatible). Set false in production when ready.
PARTICIPANT_LEGACY_OPEN_MUTATIONS=true
# If set, callers may send header X-Admin-Secret matching this value instead of a user JWT when LEGACY is false.
# ADMIN_API_SECRET=

# Optional / reserved for upcoming features (not read by env validation yet):
# API_FOOTBALL_KEY=
# CRON_SECRET=
# DEFAULT_COMPETITION_SLUG=wc2026
